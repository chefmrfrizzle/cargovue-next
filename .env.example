# This file contains names and safe examples only. Never put real credentials here.
NODE_ENV=development
LOG_LEVEL=info

# Local development services from compose.yaml
DATABASE_URL=postgresql://cargovue_local:cargovue_local_only@localhost:5432/cargovue
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=cargovue-local
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=cargovue_local
OBJECT_STORE_SECRET_KEY=cargovue_local_only

# Identity placeholders. The app must refuse production startup if these are absent.
OKTA_ISSUER=https://example.okta.com/oauth2/default
OKTA_CLIENT_ID=replace-me

# Production signing must use KMS/HSM. Local development stays unsigned.
RELEASE_SIGNING_MODE=disabled
AWS_KMS_KEY_ID=
